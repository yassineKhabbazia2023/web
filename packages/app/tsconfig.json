{
  "extends": "../@config/tsconfig.base",
  "include": [
    "env.d.ts",
    "./src/**/*",
    "tests/**/*",
    "__mocks__",
    "./vitest.setup.ts",
    "src/**/*.json",
    "package.json"
  ],
  "exclude": [
    "node_modules"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "declarationDir": "./dist/types",
    "outDir": "./dist/types",
    "paths": {
      "@app/*": [
        "./src/*"
      ],
      "@common/*": [
        "../libraries/common/src/*"
      ],
      "@core/*": [
        "../libraries/core/src/*"
      ],
      "@styleguide/*": [
        "../libraries/styleguide/src/*"
      ],
      "@entities/*": [
        "../applets/entities/src/*"
      ],
      "@ged/*": [
        "../applets/ged/src/*"
      ],
      "@launcher/*": [
        "../applets/launcher/src/*"
      ],
      "@login/*": [
        "../applets/login/src/*"
      ],
      "@mandate/*": [
        "../applets/mandate/src/*"
      ],
      "@offers-catalog/*": [
        "../applets/offers-catalog/src/*"
      ],
      "@powerbi/*": [
        "../applets/powerbi/src/*"
      ]
    },
    "types": [
      "@pinia/testing",
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node"
    ]
  }
}
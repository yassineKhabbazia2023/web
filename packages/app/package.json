{
  "name": "@pulse/app",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Front of Pulse app",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "depcruise": "depcruise src",
    "depcruise:graph": "npx depcruise --include-only \"^src\" --output-type dot . | dot -T svg > dependency-graph.svg",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.9.0",
    "@braintree/sanitize-url": "^7.0.0",
    "@pulse/common": "1.0.0",
    "@pulse/entities": "1.0.0",
    "@pulse/ged": "1.0.0",
    "@pulse/launcher": "1.0.0",
    "@pulse/login": "1.0.0",
    "@pulse/mandate": "1.0.0",
    "@pulse/styleguide": "^2.2.763",
    "@vue/test-utils": "^2.4.0",
    "dayjs": "^1.11.13",
    "idlejs": "^3.0.0",
    "jwt-decode": "^3.1.2",
    "lodash-es": "^4.17.21",
    "pinia": "^2.1.4",
    "product-fruits": "^1.0.25",
    "vite": "^5.4.4",
    "vitest": "^2.0.0",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.2.4",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@amplitude/analytics-types": "^2.8.0",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@pinia/testing": "^0.1.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.1",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^20.4.4",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitest/coverage-istanbul": "^2.0.0",
    "dependency-cruiser": "^16.4.1",
    "jsdom": "^22.1.0",
    "rollup-plugin-typescript-paths": "^1.4.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass-loader": "^13.3.0",
    "sass": "^1.62.1",
    "vite-plugin-css-injected-by-js": "^3.1.1",
    "vite-plugin-externals": "^0.6.2",
    "vue-tsc": "^2.0.0"

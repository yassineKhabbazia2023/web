{
  "extends": "../../@config/tsconfig.base.app",
  // No "references" on purpose: e2e-mocks' @pulse/* imports resolve to workspace
  // sources via npm hoisting, so it doesn't need referenced projects to be built
  // first. It is still built as part of the graph when referenced (e.g. by backoffice).
  "compilerOptions": {
    // Node's native ESM resolver (used when Vite loads this package's plugin entry
    // outside its esbuild bundling) requires explicit extensions on relative imports.
    "allowImportingTsExtensions": true
  }
}

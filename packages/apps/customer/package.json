{
  "name": "@pulse/customer",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Customer Front of Pulse app",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:e2e": "VITE_E2E_MODE=true vite --port 1337",
    "dev:mocks": "VITE_DEV_MOCKS=true vite",
    "dev:proxy": "VITE_PROXY_ENABLED=true vite",
    "build": "npm run build:vite --",
    "preview": "vite preview",
    "build:vite": "vite build --emptyOutDir",
    "build:types": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@pulse/booking": "1.0.0",
    "@pulse/common": "1.0.0",
    "@pulse/entities": "1.0.0",
    "@pulse/feed-center": "1.0.0",
    "@pulse/ged": "1.0.0",
    "@pulse/homepage": "1.0.0",
    "@pulse/key-moments": "1.0.0",
    "@pulse/launcher": "1.0.0",
    "@pulse/login": "1.0.0",
    "@pulse/mandate": "1.0.0",
    "@pulse/pennylane": "1.0.0",
    "@pulse/powerbi": "1.0.0",
    "@pulse/shared": "1.0.0",
    "@pulse/styleguide": "3.1.0",
    "@pulse/toolbox": "1.0.0",
    "@pulse/widgets": "1.0.0"
  },
  "devDependencies": {
    "@pulse/e2e-mocks": "1.0.0"
  }
}

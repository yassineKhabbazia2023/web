    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@pulse/common": "1.0.0",
    "@pulse/e2e-mocks": "1.0.0",
    "@pulse/styleguide": "3.1.0",
    "@pulse/toolbox": "1.0.0"
  }

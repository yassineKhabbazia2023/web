{
  "extends": ["./tsconfig.base", "./tsconfig.paths"],
  "include": [
    "${configDir}/env.d.ts",
    "${configDir}/src/**/*",
    "${configDir}/src/**/*.json",
    "${configDir}/tests/**/*",
    "${configDir}/__mocks__",
    "${configDir}/package.json"
  ],
  "compilerOptions": {
    "types": [
      "@pinia/testing",
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node"
    ],
    "declarationDir": "${configDir}/dist/types",
    "outDir": "${configDir}/dist/types"
  }
}

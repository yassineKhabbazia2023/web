<div pdata="[object Object],[object Object]" tablelayout="fixed" showoverflowtooltip="" pstripe="">
  <div plabel="Company name" pprop="name" psortable="" pminwidth="120px">
    <div class="flex flex--align-items-center overflow-hidden">
      <p-avatar-stub pcolor="amethyste" ptype="xsmall" pfit="cover" pshape="circle" pselected="false"></p-avatar-stub>
      <p class="font-semibold margin-left--2">EC23696400_SLS 4_loop</p>
    </div>
  </div>
  <div plabel="Client code" pprop="accountNumber" psortable=""></div>
  <div plabel="Report type" pprop="reportType" psortable="">
    <div pcontent="Customer label: TBD Financier" pplacement="top">
      <p>Rapport Loop</p>
    </div>
  </div>
  <div plabel="Initialized on" pprop="initializedOn" psortable="">
    <p>5/30/2024</p>
  </div>
  <div plabel="Updated on" pprop="updatedOn" psortable="">
    <p>2/20/2025</p>
  </div>
  <div plabel="Status" pwidth="150" pprop="status" psortable="">
    <p-tag-stub pcontent="Online" pcolor="success" piconleftname="checkCircle" peffect="light" pround="true" pdisabletransitions="false" pclosable="false" style="width: 70%;"></p-tag-stub>
  </div>
  <div plabel="Actions" pwidth="100" pprop="actions">
    <p-button-stub ptype="default" pround="false" pcircle="false" pdisabled="false" ploading="false" psize="small" picononly="false" pisactive="false" ptag="button"></p-button-stub>
  </div>
</div>
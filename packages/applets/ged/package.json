{
  "name": "@pulse/ged",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "GED Applet",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "npm run build:types && npm run build:vite",
    "build:types": "vue-tsc --build --force",
    "build:vite": "vite build",
    "depcruise": "depcruise src",
    "depcruise:graph": "npx depcruise --include-only \"^src\" --output-type dot . | dot -T svg > dependency-graph.svg",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@pulse/common": "1.0.0",
    "@pulse/styleguide": "^2.2.823",
    "axios": "^1.7.7",
    "element-plus": "2.4.3",
    "pinia": "^2.2.4",
    "vite": "^5.4.8",
    "vue": "^3.3.4",
    "vue-i18n": "^9.14.1",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@pinia/testing": "^0.1.6",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.16.10",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitest/coverage-istanbul": "^2.1.3",
    "@vue/test-utils": "^2.4.6",
    "dependency-cruiser": "^16.4.2",
    "jsdom": "^22.1.0",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.79.4",
    "vite-plugin-externals": "^0.6.2",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.1.6"
  }
}

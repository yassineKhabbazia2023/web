{
  "name": "@pulse/common",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Common library",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    "./constants": "./src/constants.mts",
    "./types": "./src/types.mts",
    ".": "./src/main.mts"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:vite",
    "build:types": "vue-tsc --build --force",
    "build:vite": "vite build",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  }
}

    "./services/current-user": "./src/services/current-user/index.ts",
    "./services/permissions": "./src/services/permissions/index.ts",
    "./services/entities": "./src/services/entities/index.ts",
    "./services/msal": "./src/services/msal/index.ts",
    "./services/invoices-access": "./src/services/invoices-access/index.ts",
    "./services/pennylane": "./src/services/pennylane/index.ts",

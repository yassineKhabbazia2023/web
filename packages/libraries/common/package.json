{
  "name": "@pulse/common",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Common library",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    "./constants": "./src/constants.mts",
    "./managers": "./src/managers/index.mts",
    "./helpers": "./src/helpers/index.mts",
    "./services/cgu": "./src/services/cgu/index.mts",
    "./services/current-user": "./src/services/current-user/index.mts",
    "./services/permissions": "./src/services/permissions/index.mts",
    "./types": "./src/types.mts",
    "./stores": "./src/stores/main.mts",
    "./mocks": "./src/__mocks__/index.ts",
    ".": "./src/main.mts"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:vite",
    "build:types": "vue-tsc --build --force",
    "build:vite": "vite build",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  }
}
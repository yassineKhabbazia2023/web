{
  "name": "@pulse/common",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Common library",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "npm run build:types && npm run build:vite",
    "build:types": "vue-tsc --build --force",
    "build:vite": "vite build",
    "depcruise": "depcruise src",
    "depcruise:graph": "npx depcruise --include-only \"^src\" --output-type dot . | dot -T svg > dependency-graph.svg",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.9.0",
    "@braintree/sanitize-url": "^7.0.0",
    "@microsoft/signalr": "^8.0.0",
    "axios": "^1.7.4",
    "jwt-decode": "^3.1.2",
    "lodash.debounce": "^4.0.8",
    "msal": "^1.4.18",
    "pinia": "^2.1.4",
    "vue": "^3.3.4",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@amplitude/analytics-types": "^2.8.0",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@pinia/testing": "^0.1.2",
    "@rollup/plugin-typescript": "^11.1.1",
    "@types/lodash.debounce": "^4.0.7",
    "@types/node": "^20.4.4",
    "@vitest/coverage-istanbul": "^2.0.0",
    "@vue/test-utils": "^2.4.0",
    "dependency-cruiser": "^16.4.1",
    "jsdom": "^22.1.0",
    "rollup-plugin-typescript-paths": "^1.4.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "vite": "^5.4.4",
    "vite-plugin-externals": "^0.6.2",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  }
}

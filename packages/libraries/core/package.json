{
  "name": "@pulse/core",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Core library",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/types.mts",
    "./mocks": "./src/mocks.mts",
    "./utils/array": "./src/utils/array/array.utils.ts",
    "./utils/validator": "./src/utils/validators/validators.utils.ts",
    "./utils/test": "./src/utils/test.utils.ts",
    ".": "./src/main.mts"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:vite",
    "build:types": "vue-tsc --build --force",
    "build:vite": "vite build",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  }
}
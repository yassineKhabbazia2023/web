{
  "name": "@pulse/shared",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Shared library",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    "./components": "./src/components/components.ts",
    "./composables": "./src/composables/index.ts",
    "./guards": "./src/guards/index.ts",
    "./layouts": "./src/layouts.ts",
    "./managers": "./src/managers/index.ts",
    "./mocks": "./src/__mocks__/index.ts",
    "./pages": "./src/pages.index.ts",
    "./plugins": "./src/plugins/plugins.ts",
    "./types": "./src/types/index.ts",
    ".": "./src/main.ts"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:vite",
    "build:types": "vue-tsc --build",
    "build:vite": "vite build",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@pulse/toolbox": "1.0.0",
    "@pulse/common": "1.0.0",
    "@pulse/styleguide": "3.1.0",
    "dayjs": "^1.11.13",
    "product-fruits": "^1.0.26"
  }
}

    "./utils/array": "./src/utils/array/array.utils.ts",
    "./utils/browser": "./src/utils/browser/browser.utils.ts",
    "./utils/object": "./src/utils/object/object.utils.ts",
    "./utils/dates": "./src/utils/dates/dates.utils.ts",
    "./utils/e2e": "./src/utils/e2e/e2e.utils.ts",
    "./utils/validator": "./src/utils/validators/index.ts",
    "./utils/banking-validators": "./src/utils/banking-validators/index.ts",
    "./utils/pdf-text-extractor": "./src/utils/pdf-text-extractor/index.ts",
    "./utils/pdf-worker": "./src/utils/pdf-worker/index.ts",
    "./utils/rib-extraction": "./src/utils/rib-extraction/index.ts",
    "./utils/string": "./src/utils/string/string.utils.ts",
    "./utils/html": "./src/utils/html/html.utils.ts",
    "./utils/http": "./src/utils/http/http.utils.ts",
    "./utils/url": "./src/utils/url/url.utils.ts",
    "./utils/test": "./src/utils/test.utils.ts",
    ".": "./src/main.ts"

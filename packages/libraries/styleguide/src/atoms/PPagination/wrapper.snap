<div class="p-pagination">
  <div class="p-pagination__select">
    <div class="el-select" data-testid="wallet-pagination-select">
      <div label="Number of documents">
        <div value="100">100 documents</div>
        <div value="200">200 documents</div>
        <div value="300">300 documents</div>
      </div>
    </div>
  </div>
  <div class="el-pagination" background="false" data-testid="wallet-pagination-pages"></div>
  <div class="p-pagination__total-page-counter" data-testid="wallet-pagination-counter"></div>
</div>
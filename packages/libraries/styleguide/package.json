{
  "name": "@pulse/styleguide",
  "version": "2.2.900",
  "description": "Design System library",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    "./components": "./src/components.mts",
    "./types": "./src/types.mts",
    ".": "./src/main.mts"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:vite",
    "build:types": "vue-tsc --build --force",
    "build:vite": "vite build",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "test": "npx vitest run",
    "test:ci": "vitest run --coverage",
    "test:update": "npx vitest -u",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "generate": "npm run generate:icons && npm run generate:images",
    "generate:icons": "tsx ./scripts/pulseIconGen.ts ./src/assets/icons ./src/atoms/PIcon/components ./src/types/IconName.types.ts && eslint ./src/atoms/PIcon/components/* --fix",
    "generate:images": "tsx ./scripts/generateImages.ts ./src/assets/images-origin ./src/assets/images ./src/atoms/PImage/imagesList.json ./src/atoms/PImage/ImageNameTypes.ts && eslint ./src/atoms/PImage/* --fix"
  },
  "devDependencies": {
    "histoire": "^0.17.0"
  }
}

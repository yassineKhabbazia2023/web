{
  "name": "@pulse/styleguide",
  "version": "3.1.0",
  "author": "Pulse Team",
  "description": "Pulse Design System library",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    "./components": "./src/components.ts",
    "./types": "./src/types.ts",
    "./fonts": "./src/assets/fonts/index.css",
    "./utils/validators": "./src/utils/validators/validators.ts",
    "./utils/fileExtension": "./src/utils/fileExtension.ts",
    "./scss/breakpoints": "./src/assets/scss/pegase/_breakpoints.scss",
    ".": "./src/main.ts"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:vite",
    "build:types": "vue-tsc --build",
    "build:vite": "vite build",
    "test": "npx vitest run",
    "test:ci": "vitest run --coverage",
    "test:update": "npx vitest -u",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "generate": "npm run generate:icons && npm run generate:images && npm run generate:colors",
    "generate:icons": "tsx ./scripts/pulseIconGen.ts ./src/assets/icons ./src/atoms/PIcon/components ./src/types/IconName.types.ts && eslint ./src/atoms/PIcon/components/* --fix",
    "generate:images": "tsx ./scripts/generateImages.ts ./src/assets/images-origin ./src/assets/images ./src/atoms/PImage/imagesList.json ./src/atoms/PImage/ImageNameTypes.ts && eslint ./src/atoms/PImage/* --fix",
    "generate:colors": "tsx ./scripts/generate-colors.ts",
    "serve:assets": "tsx ./scripts/assets"
  },
  "dependencies": {
    "@pulse/toolbox": "1.0.0",
    "country-flag-icons": "^1.6.15",
    "element-plus": "2.4.3",
    "libphonenumber-js": "^1.12.41"
  }
}

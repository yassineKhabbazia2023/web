{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "dev": {
            "persistent": true,
            "cache": false
        },
        "build": {
            "cache": true,
            "outputs": [
                "dist/**"
            ]
        },
        "build:types": {
            "cache": true,
            "outputs": [
                "dist/**"
            ]
        },
        "test": {
            "cache": true
        },
        "lint": {
            "cache": true
        },
        "lint:fix": {
            "cache": true
        },
        "depcruise": {
            "cache": true
        }
    }
}
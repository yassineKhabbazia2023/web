{
  "name": "@kpmg/router",
  "version": "1.0.0",
  "description": "Router for future MFE",
  "type": "module",
  "scripts": {
    "audit": "npm audit --registry=https://registry.npmjs.org/ --audit-level=high",
    "audit:fix": "npm audit fix --registry=https://registry.npmjs.org/ --audit-level=high",
    "dev": "vite --port 8081",
    "build": "vue-tsc && vite build",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "prepare": "husky install",
    "preview": "vite preview",
    "test": "npx vitest run",
    "test:ci": "vitest run --coverage",
    "license": "license-checker  --production --excludePrivatePackages"
  },
  "author": "Pulse Team",
  "private": true,
  "engines": {
    "node": ">=18.16.0",
    "npm": ">=9.5.1"
  },
  "lint-staged": {
    "*.{js, ts, vue, json}": "npm run lint"
  },
  "dependencies": {
    "@kpmg/styleguide": "^2.2.139",
    "idlejs": "^3.0.0",
    "jwt-decode": "^3.1.2",
    "pinia": "^2.1.3",
    "single-spa-vue": "^2.5.1",
    "vue": "^3.3.4",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.3",
    "@commitlint/config-conventional": "^17.6.3",
    "@intlify/unplugin-vue-i18n": "^0.11.0",
    "@kpmg/common": "^3.1.56",
    "@kpmg/config-pulse": "^1.59.1-beta1",
    "@kpmg/eslint-config-pulse": "^1.70.3",
    "@pinia/testing": "^0.1.3",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitest/coverage-istanbul": "^0.30.1",
    "@vitest/ui": "^0.32.0",
    "@vue/test-utils": "^2.3.2",
    "husky": "^8.0.3",
    "license-checker": "^25.0.1",
    "lint-staged": "^13.2.2",
    "rollup-plugin-visualizer": "^5.9.0",
    "sass": "^1.62.1",
    "sass-loader": "^13.3.0",
    "typescript": "^5.0.4",
    "vite": "^4.3.8",
    "vite-plugin-css-injected-by-js": "^3.3.0",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-externals": "^0.6.2",
    "vitest": "^0.34.4",
    "vue-tsc": "^1.6.5"
  }
}

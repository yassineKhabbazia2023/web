{
  "name": "@kpmg/common",
  "version": "3.1.28",
  "description": "Common",
  "license": "ISC",
  "author": "Pulse Team",
  "type": "module",
  "engines": {
    "node": ">= 18.16.0",
    "npm": ">= 9.5.1"
  },
  "main": "dist/lib/common.umd.js",
  "module": "dist/lib/common.es.js",
  "types": "dist/types/src/main.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "npm run build:vite && npm run build:types",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly",
    "build:vite": "vite build",
    "dev": "vite",
    "format": "prettier --write src/",
    "license": "license-checker --onlyAllow \"MIT; ISC; Apache-2.0; MIT AND CC-BY-3.0; CC-BY-3.0; CC0-1.0; BSD-3-Clause; BSD-2-Clause; 0BSD; Python-2.0; Unlicense\" --production --excludePrivatePackages --unknown ",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:fix": "eslint . --fix --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "prepare": "husky install",
    "preview": "vite preview",
    "push": "npm publish",
    "release": "npx semantic-release",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "lint-staged": {
    "*.{js, ts, vue, json}": "npm run lint"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint",
      "commit-msg": "commitlint -e $HUSKY_GIT_PARAMS && if [ $? -eq 1 ]; then git log -1 --pretty=format:'%B' | grep -qE '^.{0,100}$' || exit 0; else exit 0; fi"
    }
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.0",
    "axios": "^1.4.0",
    "jwt-decode": "^3.1.2",
    "lodash.debounce": "^4.0.8",
    "msal": "^1.4.18",
    "pinia": "^2.1.4",
    "vue": "^3.3.4",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.3",
    "@commitlint/config-conventional": "^17.6.3",
    "@intlify/unplugin-vue-i18n": "^0.12.2",
    "@kpmg/config-pulse": "^1.59.1-beta1",
    "@kpmg/eslint-config-pulse": "^1.66.5",
    "@pinia/testing": "^0.1.2",
    "@rollup/plugin-replace": "^5.0.2",
    "@rollup/plugin-typescript": "^11.1.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.3",
    "@types/lodash.debounce": "^4.0.7",
    "@types/node": "^20.4.4",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitest/coverage-istanbul": "^0.32.0",
    "@vue/test-utils": "^2.4.1",
    "@vue/tsconfig": "^0.4.0",
    "husky": "^8.0.3",
    "jsdom": "^22.1.0",
    "license-checker": "^25.0.1",
    "lint-staged": "^13.2.3",
    "rollup-plugin-typescript-paths": "^1.4.0",
    "semantic-release": "21.0.2",
    "semantic-release-ado": "^1.4.0",
    "tsconfig": "^7.0.0",
    "tslib": "^2.6.0",
    "vite": "^4.4.9",
    "vite-plugin-eslint": "1.8.1",
    "vite-plugin-externals": "^0.6.2",
    "vitest": "^0.34.4",
    "vue-tsc": "^1.8.6"
  }
}

{
  "name": "@pulse/front",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Unique repository of Pulse Front (web)",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "packages/libraries/*",
    "packages/applets/*",
    "packages/apps/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "packageManager": "npm@10.0.0",
  "scripts": {
    "audit": "npm audit --registry=https://registry.npmjs.org/ --audit-level=high",
    "audit:fix": "npm audit fix --registry=https://registry.npmjs.org/ --audit-level=high",
    "backoffice:dev": "npm run dev --workspace=@pulse/backoffice",
    "customer:dev": "npm run dev --workspace=@pulse/customer",
    "collaborator:dev": "npm run dev --workspace=@pulse/collaborator",
    "app:build": "npm run app:pre-build && npm run build --workspace=@pulse/customer && npm run build --workspace=@pulse/collaborator",
    "app:dev": "npm run dev --workspace=@pulse/customer",
    "app:pre-build": "tsx ./Pipelines/scripts/pre-build.ts ../../version.json",
    "app:preview": "npm run preview --workspace=@pulse/customer",
    "styleguide:generate": "npm run generate --workspace=@pulse/styleguide",
    "styleguide:serve:assets": "npm run serve:assets --workspace=@pulse/styleguide",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "vitest --bail 1 --reporter=default --reporter=junit --outputFile=coverage/junit.xml",
    "test:changed": "vitest --changed origin/main --bail 1 --reporter=default --reporter=junit --outputFile=coverage/junit.xml",
    "build": "npm run build:types --workspaces --if-present && npm run build --workspace=@pulse/customer && npm run build --workspace=@pulse/collaborator",
    "build:all": "npm run build --workspaces --if-present",
    "build:types": "npm run build:types --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "license": "license-checker --onlyAllow \"MIT; ISC; Apache-2.0; MIT AND CC-BY-3.0; CC-BY-3.0; CC0-1.0; BSD-3-Clause; BSD-2-Clause; 0BSD; Python-2.0; BlueOak-1.0.0; MPL-2.0; Unlicense\" --production --excludePrivatePackages --unknown ",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "storybook": "storybook dev -p 6009",
    "storybook:build": "storybook build -o dist-storybook",
    "storybook:preview": "vite preview --outDir dist-storybook --base=/storybook/",
    "e2e": "npm run e2e --workspaces --if-present",
    "e2e:customer": "npm run e2e --workspace=@pulse/customer",
    "e2e:customer:report": "npm run e2e:report --workspace=@pulse/customer"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.11.7",
    "@amplitude/plugin-session-replay-browser": "^1.21.1",
    "@azure/msal-browser": "^4.14.0",
    "@element-plus/icons-vue": "2.3.1",
    "@microsoft/signalr": "^8.0.7",
    "@vueuse/core": "^14.0.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "element-plus": "2.4.3",
    "eslint-plugin-import": "^2.31.0",
    "fast-xml-parser": "^5.2.3",
    "file-saver": "^2.0.5",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.21",
    "pinia": "^2.2.4",
    "powerbi-client": "^2.23.1",
    "powerbi-models": "1.15.2",
    "product-fruits": "^1.0.26",
    "tslog": "^4.9.2",
    "vue": "^3.5.13",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@amplitude/analytics-types": "^2.8.2",
    "@eslint/compat": "^1.2.2",
    "@eslint/js": "^9.14.0",
    "@intlify/unplugin-vue-i18n": "^6.0.0",
    "@pinia/testing": "^0.1.6",
    "@playwright/test": "^1.49.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@storybook/addon-a11y": "^10.1.5",
    "@storybook/addon-docs": "^10.1.5",
    "@storybook/vue3-vite": "^10.1.5",
    "@stylistic/eslint-plugin": "^2.11.0",
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.16.10",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-istanbul": "^4.0.0",
    "@vitest/eslint-plugin": "^1.1.7",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.4.0",
    "baseline-browser-mapping": "^2.9.15",
    "eslint": "^9.11.1",
    "eslint-plugin-storybook": "^10.1.5",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.10.0",
    "jsdom": "^22.1.0",
    "license-checker": "^25.0.1",
    "lightningcss": "^1.25.0",
    "msw": "^2.12.4",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.79.4",
    "storybook": "^10.1.5",
    "svgo": "^3.0.2",
    "terser": "^5.31.0",
    "tsx": "^4.19.1",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8.13.0",
    "vite": "^7.1.9",
    "vite-plugin-externals": "^0.6.2",
    "vitepress": "^2.0.0-alpha.15",
    "vitest": "^4.0.0",
    "vue-tsc": "^2.1.6"
  }
}

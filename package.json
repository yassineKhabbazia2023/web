{
  "name": "@pulse/front",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Unique repository of Pulse Front (web)",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "packages/libraries/*",
    "packages/applets/*",
    "packages/app"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "packageManager": "npm@10.0.0",
  "scripts": {
    "audit": "npm audit --registry=https://registry.npmjs.org/ --audit-level=high",
    "audit:fix": "npm audit fix --registry=https://registry.npmjs.org/ --audit-level=high",
    "app:dev": "turbo run dev --filter=@pulse/app",
    "app:build": "turbo run build --filter=@pulse/app",
    "test": "turbo run test",
    "build": "turbo run build",
    "build:types": "turbo run build:types",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "depcruise": "turbo run depcruise",
    "license": "license-checker --onlyAllow \"MIT; ISC; Apache-2.0; MIT AND CC-BY-3.0; CC-BY-3.0; CC0-1.0; BSD-3-Clause; BSD-2-Clause; 0BSD; Python-2.0; Unlicense\" --production --excludePrivatePackages --unknown ",
    "mfe:copy:libs": "tsx ./scripts/copy-libs.ts",
    "mfe:copy:applets": "tsx ./scripts/copy-applets.ts",
    "mfe:copy:apps": "tsx ./scripts/copy-apps.ts",
    "node:clean": "rm -rf ./package-lock.json && rm -rf node_modules && rm -rf ./packages/**/**/node_modules"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^3.0.0",
    "@stylistic/eslint-plugin": "^2.7.2",
    "@stylistic/eslint-plugin-js": "^2.7.2",
    "@stylistic/eslint-plugin-ts": "^2.7.2",
    "@tsconfig/node20": "^20.1.4",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-vitest": "0.4.1",
    "license-checker": "^25.0.1",
    "syncpack": "^13.0.0",
    "tsx": "^4.19.1",
    "turbo": "^2.1.2"
  }
}

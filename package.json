{
  "name": "@pulse/front",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Unique repository of Pulse Front (web)",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "packages/libraries/*",
    "packages/applets/*",
    "packages/app"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "packageManager": "npm@10.0.0",
  "scripts": {
    "audit": "npm audit --registry=https://registry.npmjs.org/ --audit-level=high",
    "audit:fix": "npm audit fix --registry=https://registry.npmjs.org/ --audit-level=high",
    "app:dev": "npm run dev --workspace=@pulse/app",
    "app:build": "npm run build --workspace=@pulse/app",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "vitest",
    "build": "npm run build --workspaces --if-present",
    "build:types": "npm run build:types --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "depcruise": "npm run depcruise --workspaces --if-present",
    "syncpack:list": "syncpack list-mismatches",
    "syncpack:fix": "syncpack fix-mismatches",
    "license": "license-checker --onlyAllow \"MIT; ISC; Apache-2.0; MIT AND CC-BY-3.0; CC-BY-3.0; CC0-1.0; BSD-3-Clause; BSD-2-Clause; 0BSD; Python-2.0; Unlicense\" --production --excludePrivatePackages --unknown ",
    "mfe:copy:libs": "tsx ./scripts/copy-libs.ts",
    "mfe:copy:applets": "tsx ./scripts/copy-applets.ts",
    "mfe:copy:apps": "tsx ./scripts/copy-apps.ts",
    "node:clean": "rm -rf node_modules && rm -rf ./packages/**/**/node_modules"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^3.0.0",
    "@stylistic/eslint-plugin": "^2.8.0",
    "@stylistic/eslint-plugin-js": "^2.8.0",
    "@stylistic/eslint-plugin-ts": "^2.8.0",
    "@tsconfig/node20": "^20.1.4",
    "@vitest/coverage-istanbul": "^2.1.3",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vitest": "0.4.1",
    "license-checker": "^25.0.1",
    "syncpack": "^13.0.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3"
  }
}

{
  "name": "@pulse/front",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Unique repository of Pulse Front (web)",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "packages/libraries/*",
    "packages/applets/*",
    "packages/app"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "packageManager": "npm@10.0.0",
  "scripts": {
    "audit": "npm audit --registry=https://registry.npmjs.org/ --audit-level=high",
    "audit:fix": "npm audit fix --registry=https://registry.npmjs.org/ --audit-level=high",
    "app:dev": "npm run dev --workspace=@pulse/app",
    "app:build": "npm run build --workspace=@pulse/app",
    "app:preview": "npm run preview --workspace=@pulse/app",
    "styleguide:generate": "npm run generate --workspace=@pulse/styleguide",
    "styleguide:serve:assets": "npm run serve:assets --workspace=@pulse/styleguide",
    "styleguide:story:dev": "npm run story:dev --workspace=@pulse/styleguide",
    "styleguide:story:build": "npm run story:build --workspace=@pulse/styleguide",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "vitest --no-file-parallelism --bail 1",
    "build": "npm run build:types --workspaces --if-present && npm run build --workspace=@pulse/app",
    "build:all": "npm run build --workspaces --if-present",
    "build:types": "npm run build:types --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:staged": "lint-staged",
    "depcruise": "depcruise packages",
    "syncpack:list": "syncpack list-mismatches",
    "syncpack:fix": "syncpack fix-mismatches",
    "license": "license-checker --onlyAllow \"MIT; ISC; Apache-2.0; MIT AND CC-BY-3.0; CC-BY-3.0; CC0-1.0; BSD-3-Clause; BSD-2-Clause; 0BSD; Python-2.0; BlueOak-1.0.0; Unlicense\" --production --excludePrivatePackages --unknown ",
    "change:picon": "tsx ./scripts/change-picon.ts",
    "change:console": "tsx ./scripts/change-console.ts",
    "change:console:specFiles": "tsx ./scripts/change-console.ts specFiles",
    "styleguide:change:icons": "tsx ./scripts/icons-styleguide.ts",
    "styleguide:change:imports": "tsx ./scripts/imports-styleguide.ts",
    "node:clean": "rm -rf node_modules && rm -rf ./packages/**/**/node_modules",
    "turbo:test": "turbo test",
    "turbo:test:continue": "turbo test --continue",
    "turbo:build": "turbo build",
    "turbo:build:continue": "turbo build --continue",
    "turbo:lint": "turbo lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.11.7",
    "@braintree/sanitize-url": "^7.1.0",
    "@element-plus/icons-vue": "2.3.1",
    "@microsoft/signalr": "^8.0.7",
    "@vueuse/core": "^10.2.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "element-plus": "2.4.3",
    "eslint-plugin-import": "^2.31.0",
    "file-saver": "^2.0.5",
    "idlejs": "^3.0.0",
    "jwt-decode": "^3.1.2",
    "lodash-es": "^4.17.21",
    "lodash.debounce": "^4.0.8",
    "msal": "^1.4.18",
    "pinia": "^2.2.4",
    "powerbi-client": "^2.23.1",
    "product-fruits": "^1.0.26",
    "tslog": "^4.9.2",
    "vue": "^3.3.4",
    "vue-i18n": "^9.14.1",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@amplitude/analytics-types": "^2.8.2",
    "@eslint/compat": "^1.2.2",
    "@eslint/js": "^9.14.0",
    "@histoire/plugin-vue": "^0.17.1",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@pinia/testing": "^0.1.6",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@stylistic/eslint-plugin": "^2.11.0",
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20.16.10",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitest/coverage-istanbul": "^2.1.3",
    "@vitest/eslint-plugin": "^1.1.7",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.4.0",
    "dependency-cruiser": "^16.4.2",
    "eslint": "^9.11.1",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.10.0",
    "husky": "^9.1.7",
    "jsdom": "^22.1.0",
    "license-checker": "^25.0.1",
    "lint-staged": "^15.2.10",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.79.4",
    "svgo": "^3.0.2",
    "syncpack": "^13.0.0",
    "tsx": "^4.19.1",
    "turbo": "^2.3.0",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.8",
    "vite-plugin-externals": "^0.6.2",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.1.6"
  }
}

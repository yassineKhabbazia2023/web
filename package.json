{
  "name": "@pulse/front",
  "version": "1.0.0",
  "author": "Pulse Team",
  "description": "Unique repository of Pulse Front (web)",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "packages/libraries/*",
    "packages/applets/*",
    "packages/apps/*"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "packageManager": "npm@11.0.0",
  "scripts": {
    "audit": "npm audit --registry=https://registry.npmjs.org/ --audit-level=high --omit=dev",
    "audit:fix": "npm audit fix --registry=https://registry.npmjs.org/",
    "backoffice:dev": "npm run dev --workspace=@pulse/backoffice",
    "customer:dev": "npm run dev --workspace=@pulse/customer",
    "customer:dev:proxy": "npm run dev:proxy --workspace=@pulse/customer",
    "collaborator:dev": "npm run dev --workspace=@pulse/collaborator",
    "collaborator:dev:proxy": "npm run dev:proxy --workspace=@pulse/collaborator",
    "app:build": "npm run app:pre-build && npm run build --workspace=@pulse/customer && npm run build --workspace=@pulse/collaborator",
    "app:dev": "npm run dev --workspace=@pulse/customer",
    "app:pre-build": "tsx ./Pipelines/scripts/pre-build.ts ../../version.json",
    "app:preview": "npm run preview --workspace=@pulse/customer",
    "styleguide:generate": "npm run generate --workspace=@pulse/styleguide",
    "styleguide:serve:assets": "npm run serve:assets --workspace=@pulse/styleguide",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "vitest --bail 1 --reporter=default --reporter=junit --outputFile=coverage/junit.xml",
    "test:changed": "vitest --changed origin/main --bail 1 --reporter=default --reporter=junit --outputFile=coverage/junit.xml",
    "build": "npm run build:types && npm run build --workspace=@pulse/customer && npm run build --workspace=@pulse/collaborator",
    "build:all": "npm run build --workspaces --if-present",
    "build:types": "vue-tsc --build",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "license": "license-checker --onlyAllow \"MIT; ISC; Apache-2.0; MIT AND CC-BY-3.0; CC-BY-3.0; CC0-1.0; BSD-3-Clause; BSD-2-Clause; 0BSD; Python-2.0; BlueOak-1.0.0; MPL-2.0; Unlicense\" --production --excludePrivatePackages --unknown ",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "storybook": "storybook dev -p 6009",
    "storybook:build": "storybook build -o dist-storybook",
    "storybook:preview": "vite preview --outDir dist-storybook --base=/storybook/",
    "e2e": "npm run e2e --workspaces --if-present",
    "e2e:customer": "npm run e2e --workspace=@pulse/customer",
    "e2e:customer:report": "npm run e2e:report --workspace=@pulse/customer",
    "e2e:collaborator": "npm run e2e --workspace=@pulse/collaborator",
    "e2e:collaborator:report": "npm run e2e:report --workspace=@pulse/collaborator"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.11.7",
    "@amplitude/plugin-session-replay-browser": "^1.21.1",
    "@azure/msal-browser": "^4.14.0",
    "@configcat/sdk": "^1.0.2",
    "@element-plus/icons-vue": "2.3.2",
    "@formkit/auto-animate": "^0.9.0",
    "@microsoft/signalr": "^8.0.7",
    "@openfeature/config-cat-web-provider": "^0.2.0",
    "@openfeature/core": "^1.9.2",
    "@openfeature/web-sdk": "^1.7.3",
    "@vueuse/core": "^14.0.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "element-plus": "2.14.2",
    "fast-xml-parser": "^5.2.3",
    "file-saver": "^2.0.5",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.4",
    "powerbi-client": "^2.23.1",
    "powerbi-models": "1.15.2",
    "product-fruits": "^1.0.26",
    "tslog": "^4.9.2",
    "vue": "^3.5.13",
    "vue-i18n": "^11.0.0",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@amplitude/analytics-types": "^2.8.2",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^10.0.0",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/vue3-vite": "^10.3.3",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/eslint-plugin": "^1.1.7",
    "@vue/test-utils": "^2.4.6",
    "baseline-browser-mapping": "^2.9.15",
    "eslint": "^10.0.0",
    "eslint-plugin-storybook": "^10.3.3",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^15.10.0",
    "jsdom": "^28.1.0",
    "license-checker": "^25.0.1",
    "lightningcss": "^1.25.0",
    "msw": "^2.12.4",
    "sass": "^1.79.4",
    "storybook": "^10.3.3",
    "svgo": "^3.0.2",
    "tsx": "^4.19.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.0",
    "vitepress": "^2.0.0-alpha.15",
    "vitest": "^4.1.0",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.3.6"
  },
  "overrides": {
    "@vitest/expect": "^4.1.9",
    "@vitest/spy": "^4.1.9"
  }
}

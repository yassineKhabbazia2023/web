{
  "extends": ["@kpmg/eslint-config-pulse"],
  "rules": {
    "@intlify/vue-i18n/no-raw-text": "off",
    "vitest/max-expects": "off", // règle temporairement désactivée
    "vitest/prefer-expect-assertions": "off" // règle temporairement désactivée
  },
  "overrides": [
    {
      "files": [
        "*.story.vue"
      ],
      "rules": {
        "max-len": "off",
        "vue/max-len": [
          "error",
          {
            "code": 300
          }
        ]
      }
    }
  ]
}
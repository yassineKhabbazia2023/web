{
  "extends": "../packages/@config/tsconfig.base.app",
  "include": [
    "**/*.ts",
    "**/*.vue",
    "../packages/applets/**/*.ts",
    "../packages/applets/**/*.vue",
    "../packages/apps/**/*.ts",
    "../packages/apps/**/*.vue",
    "../packages/libraries/**/*.ts",
    "../packages/libraries/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "../packages/**/node_modules",
    "../packages/**/*.spec.ts"
  ],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": [
      "vite/client",
      "vitest/globals"
    ]
  }
}

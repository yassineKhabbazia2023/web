# Normalize line endings to LF on commit, and check out with LF on every OS.
# This is the single source of truth for EOL handling and overrides core.autocrlf.
* text=auto eol=lf

# Files that must keep CRLF (Windows-specific scripts)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never normalize, never diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.woff  binary
*.woff2 binary
